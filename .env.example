CAREERCOMPASS_APP_NAME=CareerNavigator AI API
CAREERCOMPASS_ENVIRONMENT=development
# Add a SerpApi key after registering for the Google Jobs API.
CAREERCOMPASS_SERPAPI_API_KEY=your_private_serpapi_key
CAREERCOMPASS_SERPAPI_COUNTRY_CODE=in
CAREERCOMPASS_SERPAPI_LANGUAGE=en
CAREERCOMPASS_SERPAPI_MAX_PAGES=3
CAREERCOMPASS_JOB_API_TIMEOUT_SECONDS=15
# PostgreSQL connection; create the database and user before initialization.
CAREERCOMPASS_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/careercompass
# For MySQL instead, use:
# CAREERCOMPASS_DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/careercompass?charset=utf8mb4
